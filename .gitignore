# ---------------------------------------------------------------
# Godot
# ---------------------------------------------------------------
# Editor cache, imported-asset cache, shader cache. Regenerated on open.
.godot/
# Android build template (large, regenerated by the editor)
/android/
# C#/.NET build output (if a Mono build is ever used)
.mono/
data_*/
mono_crash.*.json
# Export presets can store keystore/signing PASSWORDS in plain text.
# Keep exports configured locally; never commit this file.
export_presets.cfg
export_credentials.cfg

# ---------------------------------------------------------------
# Exported builds (ship via Steam/itch, never via git)
# ---------------------------------------------------------------
/build/
/builds/
/export/
/exports/
*.pck
*.exe
*.x86_64
*.x86_32
*.arm64
*.apk
*.aab
*.dmg
*.app/

# ---------------------------------------------------------------
# Secrets — keys, tokens, signing certificates
# ---------------------------------------------------------------
.env
.env.*
!.env.example
*.keystore
*.jks
*.p12
*.pfx
*.pem
*.key
*.crt
*.cer
*.mobileprovision
secrets/
credentials.json
# Steamworks: partner credentials and local SDK/content-builder config
steam_appid.txt
steamworks_sdk*/
sdk/tools/ContentBuilder/
*.vdf.local

# ---------------------------------------------------------------
# QA and test output
# ---------------------------------------------------------------
qa_output/
*.log
logs/

# ---------------------------------------------------------------
# Editors and AI tools (local state only)
# ---------------------------------------------------------------
.cursor/
.vscode/
.idea/
*.swp
*~
# Claude Code: personal permissions/settings stay local.
# Shared agent definitions in .claude/agents/ ARE committed.
.claude/settings.local.json

# ---------------------------------------------------------------
# Operating systems
# ---------------------------------------------------------------
.DS_Store
._*
Thumbs.db
desktop.ini
$RECYCLE.BIN/
